# ---------------------------------------------------------------------------
# Project: paperless-field-extractor
# ---------------------------------------------------------------------------

# Secrets. The Paperless API token is never committed: no token file, no .env
# with real values. Local runs read it from secrets/, the container from a
# mounted secret file.
secrets/
*.token
paperless-token*.txt

# Generated output: review.csv, dry-run reports and the write journal. The
# journal is the only audit trail of machine-written values and holds receipt
# data, so it is never committed.
output/
*.journal
*.journal.*

# OCR cache keyed by sha256(original) + config hash. Derived from real receipts.
.ocr-cache/
ocr-cache/

# Recorded data that has not been sanitised. Real receipts, photos and their
# OCR text stay out of git; sanitised fixtures live in tests/fixtures/.
tests/fixtures/raw/
scratch/

# Tool caches
.ruff_cache/
